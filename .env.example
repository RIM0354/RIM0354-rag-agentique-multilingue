# Copiez ce fichier en .env et remplissez vos clés. Ne publiez JAMAIS le fichier .env.
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=rapports

# LLM : gemini (clé gratuite sur https://aistudio.google.com/apikey) ou groq (https://console.groq.com)
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GROQ_API_KEY=
# Laisser vide pour le modèle par défaut (gemini-3.8-flash ou llama-3.3-70b-versatile)
LLM_MODEL=
# Modèles de secours quand le quota gratuit du jour est atteint (séparés par des virgules)
LLM_FALLBACK_MODELS=

# Embeddings : gemini (API, rien à télécharger) ou local (BGE-M3, 2,3 Go). Vide = gemini si GEMINI_API_KEY existe.
EMBED_PROVIDER=
# Reranking : llm (le LLM trie les passages), local (cross-encoder BGE, 2,3 Go) ou none
RERANK_PROVIDER=

# Traces (optionnel, gratuit) : https://cloud.langfuse.com
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# Authentification : Supabase > Project Settings > API > JWT Secret (vide = pas de vérification en local)
SUPABASE_JWT_SECRET=
CORS_ORIGINS=http://localhost:3000
